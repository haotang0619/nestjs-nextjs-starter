{
  "name": "nestjs-nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">= 24.9"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:api": "pnpm --filter ./apps/api start:dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter ./apps/api test:e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  }
}
